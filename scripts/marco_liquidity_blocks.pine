// Marco LB — Liquidity Blocks (Inter Equity Trading / Marco Accettone)
// Methodology source of truth: docs/MARCO.md. Every numeric input here is a
// [CALIBRATION] — the videos state the rules qualitatively. Defaults mirror
// the table in docs/MARCO.md §6.
//
// What it draws:
//   * Intact levels of liquidity (swing lows/highs, merged when "equal").
//     A level that accumulates touches becomes build-up (thicker line).
//   * Liquidity blocks: when a level is swept and price reclaims it within
//     `confirmBars`, the sweep extreme becomes an LB zone, extended right.
//     Qualified LBs (swept a build-up level or an old level) draw bright,
//     the rest faint — Accettone's "not every LB is an entry" filter, §3.
//   * Tap labels + alerts when price returns into a zone (strong zones only).
//   * Zones thinner than minZoneAtr draw faint — not entry-grade (§7.1).
//   * Dashed stop line past a strong zone's extreme (stopBufAtr).
//   * Zone dies when price trades beyond its extreme (the stop side, by
//     trade not by close) or on age-out. An aged-out zone's extreme goes back
//     on the map as a level: a low that was made and never taken is still
//     liquidity (v9, user 2026-09-06).
//   * LB vs build-up (v9): a later pivot holding within eqTol of a live
//     zone's extreme is a respect of it; at the build-up touch count the zone
//     retires and its extreme becomes a level — a target, not a block.
//   * Pocket floor (v9): a run that stops within eqTol short of a deeper
//     intact level is a stab into the pocket — the inner level is consumed,
//     no zone is born; the floor keeps the liquidity (6E 1.15765, 6B 1.3474).
//   * Pivots (v9): a run of equal extremes registers once, on its first bar.
//   * An unqualified zone born against a live qualified one is inducement
//     (§3, V1): under Auto bias it draws dashed as `false` and never flips
//     the bias — an LB never sets the story by itself, liquidity does.
//   * Build-up boxes (§2.1): once a level has the build-up touch count, a box
//     spans its equal extremes (`xN`) — the local target of the story; after
//     the run it stays grey as `swept xN` (toggle) until it ages out.
//   * Bias source (§3): Auto = the last qualified LB (the trap), Auto (draw)
//     = the side holding more intact build-up taps (the lean before the
//     trap), Long/Short = by hand from the weekly brief, Off = no bias.
//   * Left liquidity (v10, E1 — docs/MARCO.md §3): a run makes a valid LB
//     only when it takes the level AND the liquidity from the left. The
//     structure a run must clear = same-side levels born since the previous
//     clean same-side LB, within `structBars`. A build-up left behind (or an
//     unqualified zone) = invalid: dotted border, never flips Auto, the sweep
//     of that level is the trigger; single-touch swings left behind =
//     unrefined: the tap is the aggressive entry, their sweep the refined one.
//     Label suffix "· left P ✗" (invalid) / "· left P ~" (unrefined).
//   * Deepened runs (v10, E1): a wick within eqTol through a zone younger than
//     confirmBars is the same run deepened — the pending reopens against the
//     ORIGINAL swept level with its taps and age, not the zone's x1 extreme.
//   * The reaction origin (v11, V8 — docs/MARCO.md §3): "where did this
//     reaction occur from? look to the left-hand side". The swing flips on
//     any consumed level; the extreme of the swing an inducing move came from
//     is that move's origin — where the induced crowd's stops rest, so its
//     run is the trap. An LB born with the story (or with none) that leaves
//     the origin intact is unrefined and still sets the bias; one born
//     against a live story keeps E1's structure test (nearest x1 swing) and
//     is inducement. "· trap" marks an LB whose run took an intact origin.
//     Trap pointers: a dashed line + label at the intact origin per side
//     ("trap ↓ L · buyers induced @H"), not drawn at an alive LB extreme.
//@version=6
indicator("Marco LB — Liquidity Blocks", "Marco LB", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------- inputs ---
grpD = "Detection"
pivotLen    = input.int(3,   "Pivot length (bars each side)", minval = 1, group = grpD)
confirmBars = input.int(3,   "Reclaim swept level within (bars)", minval = 1, group = grpD,
     tooltip = "After a sweep, a close back beyond the swept level within this many bars confirms the LB. Otherwise it is a breakdown, not a trap.")
maxLevels   = input.int(20,  "Max tracked levels per side", minval = 2, group = grpD)
levelMaxAge = input.int(2000, "Level max age (bars)", minval = 100, group = grpD,
     tooltip = "Intact levels older than this drop off the map. The JS engine reads only a window of bars and inherits older levels from the higher timeframe instead (docs/MARCO.md §2.1).")

grpZ = "Zones"
zoneModeS   = input.string("Swept level", "Zone inner edge", options = ["Swept level", "Sweep candle body"], group = grpZ)
maxAgeBars  = input.int(300, "Zone max age (bars)", minval = 10, group = grpZ)
keepDead    = input.bool(false, "Keep invalidated zones (grey)", group = grpZ)

grpQ = "Qualification (LB filter)"
eqTol       = input.float(0.25, "Equal-level tolerance (ATR mult)", step = 0.05, minval = 0.0, group = grpQ)
minTouches  = input.int(2,   "Touches to call a level build-up", minval = 2, group = grpQ)
minLevelAge = input.int(50,  "…or level intact for ≥ (bars)", minval = 1, group = grpQ)
minZoneAtr  = input.float(0.25, "Min zone height (ATR mult)", step = 0.05, minval = 0.0, group = grpQ,
     tooltip = "Thinner zones draw faint and fire no alerts — the stop would sit ticks away from the entry.")
respectTol  = input.float(0.75, "Respect tolerance (ATR mult)", step = 0.05, minval = 0.0, group = grpQ,
     tooltip = "Low respecting low: a later low holding this far above a level counts as a confirming touch (docs/MARCO.md §4.4).")
structBars  = input.int(60, "Structure lookback (bars)", minval = 5, group = grpQ,
     tooltip = "Left liquidity (docs/MARCO.md §3, E1): the structure a run must clear = same-side levels born since the previous clean same-side LB, within this many bars. Mirrors the engine's story_lookback.")

grpB = "Bias"
biasMode    = input.string("Auto", "Bias", options = ["Auto", "Auto (draw)", "Long", "Short", "Off"], group = grpB,
     tooltip = "Zones against the bias draw dashed with 'false' — pullback origins, never entries (docs/MARCO.md §3). Auto = side of the last clean LB (the trap; an LB that is unqualified or left liquidity behind — 'left P' — never flips it). Auto (draw) = the side holding more intact build-up taps — Marco's lean before the trap. Long/Short = set by hand from the weekly brief. Off = no bias, nothing is marked false.")

grpU = "Build-up"
showBuildups = input.bool(true, "Build-up boxes (equal highs/lows)", group = grpU,
     tooltip = "A box across the equal extremes once a level has the build-up touch count — Accettone's 'high respecting high' liquidity, the local target of the story (docs/MARCO.md §2.1).")
keepSwept   = input.bool(true, "Keep swept build-up boxes (grey)", group = grpU,
     tooltip = "After the run the box freezes at the sweep bar and turns grey ('swept xN') until it ages out (Zone max age).")

grpV = "Visuals"
showLevels  = input.bool(true, "Show liquidity levels", group = grpV)
showPointers = input.bool(true, "Trap pointers (V8 origins)", group = grpV,
     tooltip = "After a high is run (buyers induced) a dashed line marks the low that move came from — where the induced buyers' stops rest; its run is the trap, a reclaim there the long. Mirror for sellers. Not drawn when the origin is an alive LB extreme (the box already says it). docs/MARCO.md §3, V8.")
showTaps    = input.bool(true, "Label zone taps", group = grpV)
showStops   = input.bool(true, "Stop line on strong zones", group = grpV)
stopBufAtr  = input.float(0.1, "Stop buffer (ATR mult)", step = 0.05, minval = 0.0, group = grpV)
colBull     = input.color(#26a69a, "Bullish", group = grpV, inline = "c")
colBear     = input.color(#ef5350, "Bearish", group = grpV, inline = "c")

int MAX_BLOCKS = 80
int MAX_SWEPT  = 60

// ----------------------------------------------------------------- types ---
type LqLevel
    float price
    float near      // nearest of the "equal" extremes — the build-up box's inner edge
    int   born
    int   touches
    line  ln
    box   bx = na   // build-up box, once touches >= minTouches

type Pending
    float lvl     = na // nearest swept level (reclaim target / zone inner edge)
    int   touches = 0  // best touch count among swept levels
    int   age     = 0  // oldest swept level's age at sweep, bars
    float ext     = na // excursion extreme (zone outer edge)
    int   extBar  = na
    float extBody = na // body edge of the excursion-extreme candle
    int   miss    = 0  // consecutive closes that failed to reclaim
    bool  deep    = false // v10: reopened by a deepened run (same trap)
    int   legStart = na   // v10: the structure bound carried from the deepened zone
    int   runBar  = na    // v11: the bar the run started
    float oP      = na    // v11: the reaction origin as of the run (V8)
    int   oBar    = na
    int   oAt     = na    // the bar of the run that induced the crowd

type Block
    box   bx
    line  st = na // buffered stop line, strong zones only
    float top
    float bot
    bool  isBull
    bool  qualified // "strong": build-up/age qualified AND not thin
    bool  build     // raw build-up/age qualification — the story anchor test (§3)
    bool  tapped
    bool  dead
    int   born
    int   left // bar of the sweep extreme
    int   respects = 0 // later pivots that held within eqTol of the extreme (v9)
    int   sweptT   = 1  // v10: taps of the swept level (carried into a deepened run)
    int   sweptAge = 0  // v10: age of the swept level at the run
    float leftLq   = na // v10: the liquidity the run left intact beyond its extreme (v11: build-up, origin or swing)
    int   leftLqT  = 0
    int   legStart = na
    string grade   = "clean" // v10: clean / unrefined / invalid
    string leftKind = "swing" // v11: buildup / origin / swing
    bool  ind      = false  // v11: inducement — born against a live story without the grade to flip it
    bool  trap     = false  // v11: the run took an origin that stood intact (V8)
    float oP       = na     // v11: the origin carried for a deepened run
    int   oBar     = na
    int   oAt      = na

// v11 (V8): the swing and the origins the next flip will read
type Swing
    int   dir = 0
    float curMin = na   // lowest low since the last flip-down
    int   curMinBar = na
    float curMax = na   // highest high since the last flip-up
    int   curMaxBar = na
    float upP = na      // the low the buyers' move came from
    int   upBar = na
    float upLvl = na    // the high whose run induced them
    int   upAt = na
    int   upTaken = na  // bar the origin was traded through
    float dnP = na
    int   dnBar = na
    float dnLvl = na
    int   dnAt = na
    int   dnTaken = na

type SweptBox
    box bx
    int at // sweep bar

// ----------------------------------------------------------------- state ---
var array<LqLevel> lowLvls  = array.new<LqLevel>()
var array<LqLevel> highLvls = array.new<LqLevel>()
var array<Block>   blocks   = array.new<Block>()
var array<SweptBox> sweptBoxes = array.new<SweptBox>()
var Pending pendBull = Pending.new()
var Pending pendBear = Pending.new()
var int biasDir   = 0 // +1 long, -1 short, 0 none
var int lastLbDir = 0 // side of the most recent clean LB created (Auto bias)
var int lastBullLbBorn = na // v10: bar of the previous CLEAN bull LB — the structure bound
var int lastBearLbBorn = na
var Swing sw = Swing.new()  // v11
var line  ptrBull  = na     // v11: trap pointer for longs (the buyers' origin)
var label ptrBullL = na
var line  ptrBear  = na
var label ptrBearL = na
bool originRunBull = false  // v11: alert flags
bool originRunBear = false

atrVal   = ta.atr(14)
bodyLo   = math.min(open, close)
bodyHi   = math.max(open, close)
colDead  = color.new(#787b86, 82)
colSwept = #787b86

// --------------------------------------------------------------- helpers ---
// a zone against the bias is a pullback origin, never an entry (V1 5:27–6:02)
againstBias(bool isBull, int dir) =>
    dir != 0 and (isBull ? dir < 0 : dir > 0)

// v10 (E1): the box label — "false" against the bias, else LB/lb with the
// left-liquidity suffix (✗ invalid, ~ unrefined)
blockText(bool against, bool strong, string grade, float leftLq, bool trap) =>
    string txt = against ? "false" : (strong ? "LB" : "lb")
    if trap and not against
        txt := txt + " · trap"
    if grade != "clean"
        txt := txt + " · left " + str.tostring(leftLq, format.mintick) + (grade == "invalid" ? " ✗" : " ~")
    txt

applyBias(int dir) =>
    if array.size(blocks) > 0
        for blk in blocks
            if not blk.dead
                bool against = againstBias(blk.isBull, dir)
                box.set_border_style(blk.bx, against ? line.style_dashed : (blk.grade == "invalid" ? line.style_dotted : line.style_solid))
                box.set_text(blk.bx, blockText(against, blk.qualified, blk.grade, blk.leftLq, blk.trap))

// docs/MARCO.md §3: a live build-up-qualified LB that is not invalid and not
// inducement anchors the story (v11, V8: an unrefined LB with the story
// counts); an LB born against it without the grade to flip it is inducement
// and must not flip Auto bias.
liveBuild(bool isBull) =>
    bool found = false
    if array.size(blocks) > 0
        for blk in blocks
            if not blk.dead and blk.build and blk.grade != "invalid" and not blk.ind and blk.isBull == isBull
                found := true
    found

// v11 (V8): an origin sitting at an alive same-side LB extreme is that zone's
// stop side — the V6 refinement, never left liquidity (E1 build decision 1)
atAliveExtreme(bool isBull, float p) =>
    bool hit = false
    if array.size(blocks) > 0
        for blk in blocks
            if not blk.dead and blk.isBull == isBull and math.abs((isBull ? blk.bot : blk.top) - p) <= eqTol * atrVal
                hit := true
    hit

// v11 (V8): the lowest low / highest high over the bars from `fromBar` to now
// (inclusive) — bounded, the origin lives inside the structure anyway
lowestSince(int fromBar) =>
    float v = low
    int n = math.min(bar_index - fromBar, structBars + 50)
    if n > 0
        for k = 0 to n
            v := math.min(v, low[k])
    v
highestSince(int fromBar) =>
    float v = high
    int n = math.min(bar_index - fromBar, structBars + 50)
    if n > 0
        for k = 0 to n
            v := math.max(v, high[k])
    v
// the same over a closed window of past bars [fromBar, toBar]; na when empty
lowestBetween(int fromBar, int toBar) =>
    float v = na
    if toBar >= fromBar
        int a = math.max(bar_index - toBar, 0)
        int b = math.min(bar_index - fromBar, structBars + 50)
        if b >= a
            for k = a to b
                v := na(v) ? low[k] : math.min(v, low[k])
    na(v) ? 1.0e12 : v
highestBetween(int fromBar, int toBar) =>
    float v = na
    if toBar >= fromBar
        int a = math.max(bar_index - toBar, 0)
        int b = math.min(bar_index - fromBar, structBars + 50)
        if b >= a
            for k = a to b
                v := na(v) ? high[k] : math.max(v, high[k])
    na(v) ? -1.0e12 : v

// v11 (V8): the swing flips on a consumed level — a low run turns it down and
// reads the up-swing's top as the sell-off's origin; a high run turns it up
// and reads the down-swing's bottom as the rally's origin ("where did this
// reaction occur from?"). Consecutive runs one way keep the origin.
flipSwing(Swing s, int dir, float lvl) =>
    if s.dir != dir
        s.dir := dir
        if dir > 0
            s.upP     := s.curMin
            s.upBar   := s.curMinBar
            s.upLvl   := lvl
            s.upAt    := bar_index
            s.upTaken := na
            s.curMax    := high
            s.curMaxBar := bar_index
        else
            s.dnP     := s.curMax
            s.dnBar   := s.curMaxBar
            s.dnLvl   := lvl
            s.dnAt    := bar_index
            s.dnTaken := na
            s.curMin    := low
            s.curMinBar := bar_index
    true

// an intact origin traded through: the induced crowd is trapped
markTaken(Swing s) =>
    bool bullRun = false
    bool bearRun = false
    if not na(s.upP) and na(s.upTaken) and low < s.upP
        s.upTaken := bar_index
        bullRun := true
    if not na(s.dnP) and na(s.dnTaken) and high > s.dnP
        s.dnTaken := bar_index
        bearRun := true
    [bullRun, bearRun]

// v10/v11 (E1, V8): the liquidity from the left — inside the structure (born
// after legStart) and beyond the run's extreme: the nearest build-up (the
// invalid test) and the nearest single-touch swing (E1's refined point)
leftLiq(array<LqLevel> lvls, bool isLow, float ext, int legStart) =>
    float best  = na
    int   bestT = 0
    float strongP = na
    int   strongT = 0
    if array.size(lvls) > 0
        for lv in lvls
            bool beyond = isLow ? lv.price < ext : lv.price > ext
            if beyond and lv.born > legStart
                if na(best) or (isLow ? lv.price > best : lv.price < best)
                    best  := lv.price
                    bestT := lv.touches
                if lv.touches >= minTouches and (na(strongP) or (isLow ? lv.price > strongP : lv.price < strongP))
                    strongP := lv.price
                    strongT := lv.touches
    [best, bestT, strongP, strongT]

// docs/MARCO.md §2.1: a level with the build-up touch count is a liquidity
// build-up — draw the box across its equal extremes (the local target)
updateBuildup(LqLevel lv, bool isLow) =>
    if showBuildups and lv.touches >= minTouches
        float top = isLow ? lv.near : lv.price
        float bot = isLow ? lv.price : lv.near
        if top - bot < syminfo.mintick
            bot := top - syminfo.mintick
        col = isLow ? colBull : colBear
        string txt = "x" + str.tostring(lv.touches)
        if na(lv.bx)
            lv.bx := box.new(lv.born, top, bar_index, bot,
                 border_color = color.new(col, 55), border_width = 1, border_style = line.style_dotted,
                 bgcolor = color.new(col, 90), text = txt, text_size = size.tiny,
                 text_color = color.new(col, 35), text_halign = text.align_right,
                 text_valign = isLow ? text.align_bottom : text.align_top)
        box.set_top(lv.bx, top)
        box.set_bottom(lv.bx, bot)
        box.set_text(lv.bx, txt)

// the build-up was run: freeze the box at the sweep bar (grey, "swept xN") or drop it
retireBuildup(LqLevel lv) =>
    if not na(lv.bx)
        if keepSwept
            box.set_right(lv.bx, bar_index)
            box.set_bgcolor(lv.bx, color.new(colSwept, 90))
            box.set_border_color(lv.bx, color.new(colSwept, 50))
            box.set_text_color(lv.bx, color.new(colSwept, 30))
            box.set_text(lv.bx, "swept x" + str.tostring(lv.touches))
            array.push(sweptBoxes, SweptBox.new(bx = lv.bx, at = bar_index))
            if array.size(sweptBoxes) > MAX_SWEPT
                SweptBox old = array.shift(sweptBoxes)
                box.delete(old.bx)
        else
            box.delete(lv.bx)
        lv.bx := na

// ------------------------------------ register liquidity levels ------------
// t0 = touches the level already carries (an expired/retired zone's extreme
// brings its respects); fresh levels start at 1
registerLevel(array<LqLevel> lvls, bool isLow, int pBar, float pPrice, int t0 = 1) =>
    bool merged = false
    if array.size(lvls) > 0
        for lv in lvls
            if math.abs(lv.price - pPrice) <= eqTol * atrVal
                lv.touches += t0
                lv.price := isLow ? math.min(lv.price, pPrice) : math.max(lv.price, pPrice)
                lv.near  := isLow ? math.max(lv.near, pPrice) : math.min(lv.near, pPrice)
                if not na(lv.ln)
                    line.set_y1(lv.ln, lv.price)
                    line.set_y2(lv.ln, lv.price)
                    if lv.touches >= minTouches
                        line.set_width(lv.ln, 2)
                        line.set_color(lv.ln, color.new(isLow ? colBull : colBear, 30))
                updateBuildup(lv, isLow)
                merged := true
                break
    // low respecting low (docs/MARCO.md §4.4): a later low that holds above an
    // existing level within respectTol confirms it — count the touch, keep the price
    if not merged
        float bestGap = na
        LqLevel bestLv = na
        for lv in lvls
            float gap = isLow ? pPrice - lv.price : lv.price - pPrice
            if gap > 0 and gap <= respectTol * atrVal and (na(bestGap) or gap < bestGap)
                bestGap := gap
                bestLv  := lv
        if not na(bestLv)
            bestLv.touches += t0
            if bestLv.touches >= minTouches and not na(bestLv.ln)
                line.set_width(bestLv.ln, 2)
                line.set_color(bestLv.ln, color.new(isLow ? colBull : colBear, 30))
            updateBuildup(bestLv, isLow)
            merged := true
    if not merged
        bool strongLv = t0 >= minTouches
        line lin = showLevels ?
             line.new(pBar, pPrice, bar_index, pPrice,
                 color = color.new(isLow ? colBull : colBear, strongLv ? 30 : 65),
                 width = strongLv ? 2 : 1, style = line.style_dotted) : na
        LqLevel fresh = LqLevel.new(price = pPrice, near = pPrice, born = pBar, touches = t0, ln = lin)
        array.push(lvls, fresh)
        if strongLv
            updateBuildup(fresh, isLow)
        if array.size(lvls) > maxLevels
            LqLevel old = array.shift(lvls)
            if not na(old.ln)
                line.delete(old.ln)
            if not na(old.bx)
                box.delete(old.bx)

// a zone leaves the map: grey it (keepDead) or delete it
killBlock(int i, Block blk) =>
    if keepDead
        box.set_bgcolor(blk.bx, colDead)
        box.set_border_color(blk.bx, colDead)
        box.set_text_color(blk.bx, colDead)
        if not na(blk.st)
            line.set_color(blk.st, colDead)
    else
        box.delete(blk.bx)
        if not na(blk.st)
            line.delete(blk.st)
        array.remove(blocks, i)
    true

// docs/MARCO.md §3 (bias source "draw"): the side holding more intact
// build-up taps is the draw — Marco's lean before the trap
drawBias() =>
    int up = 0
    int dn = 0
    if array.size(highLvls) > 0
        for lv in highLvls
            if lv.touches >= minTouches and lv.price > close
                up += lv.touches
    if array.size(lowLvls) > 0
        for lv in lowLvls
            if lv.touches >= minTouches and lv.price < close
                dn += lv.touches
    up > dn ? 1 : dn > up ? -1 : 0

// returns the grade (clean / unrefined / invalid) and whether the LB is
// inducement — born against a live story without the grade to flip it
newBlock(bool isBull, int leftBar, float top, float bot, bool qualified, int sT, int sAge, int legStart,
     float oP, int oBar, int oAt, int runBar) =>
    // docs/MARCO.md §7.1: a zone thinner than minZoneAtr is not entry-grade
    bool thin   = top - bot < minZoneAtr * atrVal
    bool strong = qualified and not thin
    float ext   = isBull ? bot : top
    // v10/v11 (E1, V8): the liquidity from the left. A build-up beyond the
    // extreme inside the structure → invalid. Otherwise unrefined, naming the
    // nearest x1 swing when born AGAINST a live story (E1), or the intact
    // reaction origin when born with it / with none (V8), falling back to
    // the swing. Nothing → clean.
    [swP, swT, stP, stT] = leftLiq(isBull ? lowLvls : highLvls, isBull, ext, legStart)
    bool counter = liveBuild(not isBull)
    // the origin stood intact since the run that induced the crowd, is
    // inside the structure, beyond the extreme, and is no alive LB extreme
    bool oIntact = not na(oP) and oBar > legStart and (isBull ? oP < ext : oP > ext) and not atAliveExtreme(isBull, oP) and
         (isBull ? lowestSince(oAt + 1) >= oP : highestSince(oAt + 1) <= oP)
    float lqP = na
    int   lqT = 0
    string lqKind = "swing"
    if not na(stP)
        lqP := stP
        lqT := stT
        lqKind := "buildup"
    else if counter
        if not na(swP)
            lqP := swP
            lqT := swT
        else if oIntact
            lqP := oP
            lqT := 1
            lqKind := "origin"
    else
        if oIntact
            lqP := oP
            lqT := 1
            lqKind := "origin"
        else if not na(swP)
            lqP := swP
            lqT := swT
    string grade = na(lqP) ? "clean" : (lqKind == "buildup" or not qualified) ? "invalid" : "unrefined"
    bool ind = (grade != "clean" or not qualified) and counter
    // V8: the run took an origin that stood intact when it started — the trap
    bool trap = false
    if not na(oP) and not na(oAt)
        if isBull
            trap := (runBar <= oAt + 1 or lowestBetween(oAt + 1, runBar - 1) >= oP) and lowestSince(runBar) < oP
        else
            trap := (runBar <= oAt + 1 or highestBetween(oAt + 1, runBar - 1) <= oP) and highestSince(runBar) > oP
    col   = isBull ? colBull : colBear
    fillT = strong ? 82 : 93
    bordT = strong ? 35 : 72
    txtT  = strong ? 25 : 65
    bool against = againstBias(isBull, biasDir)
    b = box.new(leftBar, top, bar_index, bot,
         border_color = color.new(col, bordT), border_width = 1,
         border_style = against ? line.style_dashed : (grade == "invalid" ? line.style_dotted : line.style_solid),
         bgcolor = color.new(col, fillT),
         text = blockText(against, strong, grade, lqP, trap), text_size = size.tiny,
         text_color = color.new(col, txtT),
         text_halign = text.align_right,
         text_valign = isBull ? text.align_bottom : text.align_top)
    line st = na
    if showStops and strong
        float stopP = isBull ? bot - stopBufAtr * atrVal : top + stopBufAtr * atrVal
        st := line.new(leftBar, stopP, bar_index, stopP,
             color = color.new(col, 35), width = 1, style = line.style_dashed)
    array.push(blocks, Block.new(bx = b, st = st, top = top, bot = bot, isBull = isBull,
         qualified = strong, build = qualified, tapped = false, dead = false, born = bar_index, left = leftBar,
         sweptT = sT, sweptAge = sAge, leftLq = lqP, leftLqT = lqT, legStart = legStart, grade = grade,
         leftKind = lqKind, ind = ind, trap = trap, oP = oP, oBar = oBar, oAt = oAt))
    if array.size(blocks) > MAX_BLOCKS
        Block old = array.shift(blocks)
        box.delete(old.bx)
        if not na(old.st)
            line.delete(old.st)
    [grade, ind]

// ------------------------------------- 0. swings (v11, V8) -----------------
if na(sw.curMin) or low < sw.curMin
    sw.curMin    := low
    sw.curMinBar := bar_index
if na(sw.curMax) or high > sw.curMax
    sw.curMax    := high
    sw.curMaxBar := bar_index
[tk0b, tk0s] = markTaken(sw)
originRunBull := originRunBull or tk0b
originRunBear := originRunBear or tk0s

// ------------------------------------------------- 1. maintain LB zones ----
bool tapBull  = false
bool tapBear  = false
bool tapBullQ = false
bool tapBearQ = false

int curBias = biasMode == "Long" ? 1 : biasMode == "Short" ? -1 : biasMode == "Off" ? 0 :
     biasMode == "Auto (draw)" ? drawBias() : lastLbDir
if curBias != biasDir
    biasDir := curBias
    applyBias(biasDir)

if array.size(blocks) > 0
    for i = array.size(blocks) - 1 to 0
        Block blk = array.get(blocks, i)
        if not blk.dead
            box.set_right(blk.bx, bar_index)
            if not na(blk.st)
                line.set_x2(blk.st, bar_index)
            // v9: a trade beyond the extreme takes the liquidity behind it —
            // the zone's stop is hit, "no reason to trade below it" no longer holds
            bool invalid = blk.isBull ? low < blk.bot : high > blk.top
            bool expired = bar_index - blk.born > maxAgeBars
            if invalid or expired
                blk.dead := true
                // v9: the zone ages out, the extreme does not — it returns to the
                // map as a level carrying the respects it collected
                if expired and not invalid
                    if blk.isBull
                        registerLevel(lowLvls, true, blk.left, blk.bot, 1 + blk.respects)
                    else
                        registerLevel(highLvls, false, blk.left, blk.top, 1 + blk.respects)
                // docs/MARCO.md §7.1: the extreme of an invalidated zone is swept
                // liquidity — open a pending sweep so a reclaim can print the new LB.
                // v10 (E1): a wick within eqTol through a zone younger than
                // confirmBars is the same run deepened — the pending reopens
                // against the ORIGINAL swept level with its taps, age and structure
                if invalid
                    bool  deep = bar_index - blk.born <= confirmBars and (blk.isBull ? blk.bot - low : high - blk.top) <= eqTol * atrVal
                    float lvl  = deep ? (blk.isBull ? blk.top : blk.bot) : (blk.isBull ? blk.bot : blk.top)
                    int   tch  = deep ? blk.sweptT : 1
                    int   age  = deep ? blk.sweptAge : bar_index - blk.left
                    if blk.isBull
                        if na(pendBull.lvl)
                            pendBull.lvl     := lvl
                            pendBull.touches := tch
                            pendBull.age     := age
                            pendBull.ext     := low
                            pendBull.extBar  := bar_index
                            pendBull.extBody := bodyLo
                            pendBull.miss    := 0
                            pendBull.runBar  := bar_index
                            // v11: the origin as of the run — a deepened run keeps the zone's
                            pendBull.oP   := deep ? blk.oP : sw.upP
                            pendBull.oBar := deep ? blk.oBar : sw.upBar
                            pendBull.oAt  := deep ? blk.oAt : sw.upAt
                        else
                            pendBull.lvl     := math.min(pendBull.lvl, lvl)
                            pendBull.touches := math.max(pendBull.touches, tch)
                            pendBull.age     := math.max(pendBull.age, age)
                        if deep
                            pendBull.deep     := true
                            pendBull.legStart := blk.legStart
                            pendBull.oP   := blk.oP
                            pendBull.oBar := blk.oBar
                            pendBull.oAt  := blk.oAt
                        flipSwing(sw, -1, lvl)
                    else
                        if na(pendBear.lvl)
                            pendBear.lvl     := lvl
                            pendBear.touches := tch
                            pendBear.age     := age
                            pendBear.ext     := high
                            pendBear.extBar  := bar_index
                            pendBear.extBody := bodyHi
                            pendBear.miss    := 0
                            pendBear.runBar  := bar_index
                            pendBear.oP   := deep ? blk.oP : sw.dnP
                            pendBear.oBar := deep ? blk.oBar : sw.dnBar
                            pendBear.oAt  := deep ? blk.oAt : sw.dnAt
                        else
                            pendBear.lvl     := math.max(pendBear.lvl, lvl)
                            pendBear.touches := math.max(pendBear.touches, tch)
                            pendBear.age     := math.max(pendBear.age, age)
                        if deep
                            pendBear.deep     := true
                            pendBear.legStart := blk.legStart
                            pendBear.oP   := blk.oP
                            pendBear.oBar := blk.oBar
                            pendBear.oAt  := blk.oAt
                        flipSwing(sw, 1, lvl)
                killBlock(i, blk)
            else if bar_index > blk.born and not blk.tapped
                bool against = againstBias(blk.isBull, biasDir)
                if blk.isBull and low <= blk.top
                    blk.tapped := true
                    tapBull  := true
                    tapBullQ := tapBullQ or (blk.qualified and not against)
                    if showTaps
                        label.new(bar_index, blk.top, against ? "false" : "tap", style = label.style_label_up,
                             color = color.new(colBull, against ? 75 : 55), textcolor = color.white, size = size.tiny)
                if not blk.isBull and high >= blk.bot
                    blk.tapped := true
                    tapBear  := true
                    tapBearQ := tapBearQ or (blk.qualified and not against)
                    if showTaps
                        label.new(bar_index, blk.bot, against ? "false" : "tap", style = label.style_label_down,
                             color = color.new(colBear, against ? 75 : 55), textcolor = color.white, size = size.tiny)

// ------------------------------------------- 2. extend intact level lines --
if array.size(lowLvls) > 0
    for lv in lowLvls
        if not na(lv.ln)
            line.set_x2(lv.ln, bar_index)
        if not na(lv.bx)
            box.set_right(lv.bx, bar_index)
if array.size(highLvls) > 0
    for lv in highLvls
        if not na(lv.ln)
            line.set_x2(lv.ln, bar_index)
        if not na(lv.bx)
            box.set_right(lv.bx, bar_index)
// v9: intact levels older than levelMaxAge drop off the map
if array.size(lowLvls) > 0
    for i = array.size(lowLvls) - 1 to 0
        LqLevel lv = array.get(lowLvls, i)
        if bar_index - lv.born > levelMaxAge
            if not na(lv.ln)
                line.delete(lv.ln)
            if not na(lv.bx)
                box.delete(lv.bx)
            array.remove(lowLvls, i)
if array.size(highLvls) > 0
    for i = array.size(highLvls) - 1 to 0
        LqLevel lv = array.get(highLvls, i)
        if bar_index - lv.born > levelMaxAge
            if not na(lv.ln)
                line.delete(lv.ln)
            if not na(lv.bx)
                box.delete(lv.bx)
            array.remove(highLvls, i)
// swept build-up boxes age out with the zones
if array.size(sweptBoxes) > 0
    for i = array.size(sweptBoxes) - 1 to 0
        SweptBox sb = array.get(sweptBoxes, i)
        if bar_index - sb.at > maxAgeBars
            box.delete(sb.bx)
            array.remove(sweptBoxes, i)

// --------------------------------------- 3. sweep scan: consume levels -----
// v9 pocket floor: a run that stops within eqTol short of a deeper intact
// level is a stab INTO the pocket, not a trap — the inner level is consumed,
// no pending opens, the floor keeps the liquidity
bool floorBelow = false
bool floorAbove = false
if array.size(lowLvls) > 0
    for lv in lowLvls
        if lv.price < low and low - lv.price <= eqTol * atrVal
            floorBelow := true
if array.size(highLvls) > 0
    for lv in highLvls
        if lv.price > high and lv.price - high <= eqTol * atrVal
            floorAbove := true
if array.size(lowLvls) > 0
    for i = array.size(lowLvls) - 1 to 0
        LqLevel lv = array.get(lowLvls, i)
        if low < lv.price and floorBelow
            if not na(lv.ln)
                line.delete(lv.ln)
            retireBuildup(lv)
            array.remove(lowLvls, i)
            flipSwing(sw, -1, lv.price)
        else if low < lv.price
            if na(pendBull.lvl)
                pendBull.lvl     := lv.price
                pendBull.touches := lv.touches
                pendBull.age     := bar_index - lv.born
                pendBull.ext     := low
                pendBull.extBar  := bar_index
                pendBull.extBody := bodyLo
                pendBull.miss    := 0
                pendBull.runBar  := bar_index
                pendBull.oP   := sw.upP   // v11: the buyers' origin as of this run
                pendBull.oBar := sw.upBar
                pendBull.oAt  := sw.upAt
            else
                pendBull.lvl     := math.min(pendBull.lvl, lv.price)
                pendBull.touches := math.max(pendBull.touches, lv.touches)
                pendBull.age     := math.max(pendBull.age, bar_index - lv.born)
            if not na(lv.ln)
                line.delete(lv.ln)
            retireBuildup(lv)
            array.remove(lowLvls, i)
            flipSwing(sw, -1, lv.price)

if array.size(highLvls) > 0
    for i = array.size(highLvls) - 1 to 0
        LqLevel lv = array.get(highLvls, i)
        if high > lv.price and floorAbove
            if not na(lv.ln)
                line.delete(lv.ln)
            retireBuildup(lv)
            array.remove(highLvls, i)
            flipSwing(sw, 1, lv.price)
        else if high > lv.price
            if na(pendBear.lvl)
                pendBear.lvl     := lv.price
                pendBear.touches := lv.touches
                pendBear.age     := bar_index - lv.born
                pendBear.ext     := high
                pendBear.extBar  := bar_index
                pendBear.extBody := bodyHi
                pendBear.miss    := 0
                pendBear.runBar  := bar_index
                pendBear.oP   := sw.dnP   // v11: the sellers' origin as of this run
                pendBear.oBar := sw.dnBar
                pendBear.oAt  := sw.dnAt
            else
                pendBear.lvl     := math.max(pendBear.lvl, lv.price)
                pendBear.touches := math.max(pendBear.touches, lv.touches)
                pendBear.age     := math.max(pendBear.age, bar_index - lv.born)
            if not na(lv.ln)
                line.delete(lv.ln)
            retireBuildup(lv)
            array.remove(highLvls, i)
            flipSwing(sw, 1, lv.price)

// v11: an origin born of this bar's flips may already be traded through
[tk1b, tk1s] = markTaken(sw)
originRunBull := originRunBull or tk1b
originRunBear := originRunBear or tk1s

// ------------------------------- 4. pending sweeps: reclaim or abandon -----
if not na(pendBull.lvl)
    if low < pendBull.ext
        pendBull.ext     := low
        pendBull.extBar  := bar_index
        pendBull.extBody := bodyLo
    if close > pendBull.lvl
        float zTop = zoneModeS == "Swept level" ? pendBull.lvl :
             math.min(pendBull.lvl, math.max(pendBull.extBody, pendBull.ext + syminfo.mintick))
        bool qual = pendBull.touches >= minTouches or pendBull.age >= minLevelAge
        // v10 (E1): the structure = levels born since the previous clean bull
        // LB, within structBars; a deepened run keeps its structure
        int legStart = not na(pendBull.legStart) ? pendBull.legStart :
             na(lastBullLbBorn) ? bar_index - structBars : math.max(lastBullLbBorn, bar_index - structBars)
        [gradeB, indB] = newBlock(true, pendBull.extBar, zTop, pendBull.ext, qual, pendBull.touches, pendBull.age, legStart,
             pendBull.oP, pendBull.oBar, pendBull.oAt, na(pendBull.runBar) ? pendBull.extBar : pendBull.runBar)
        // v11 (V8): an unrefined LB sets the bias too — the trap stands, the
        // deeper x1 is the refined entry; invalid or inducement never flips
        if qual and gradeB != "invalid" and not indB
            lastLbDir := 1
            if biasMode == "Auto" and biasDir != 1
                biasDir := 1
                applyBias(biasDir)
        if gradeB == "clean"
            lastBullLbBorn := bar_index
        pendBull := Pending.new()
    else
        pendBull.miss += 1
        if pendBull.miss > confirmBars
            pendBull := Pending.new()

if not na(pendBear.lvl)
    if high > pendBear.ext
        pendBear.ext     := high
        pendBear.extBar  := bar_index
        pendBear.extBody := bodyHi
    if close < pendBear.lvl
        float zBot = zoneModeS == "Swept level" ? pendBear.lvl :
             math.max(pendBear.lvl, math.min(pendBear.extBody, pendBear.ext - syminfo.mintick))
        bool qual = pendBear.touches >= minTouches or pendBear.age >= minLevelAge
        int legStart = not na(pendBear.legStart) ? pendBear.legStart :
             na(lastBearLbBorn) ? bar_index - structBars : math.max(lastBearLbBorn, bar_index - structBars)
        [gradeS, indS] = newBlock(false, pendBear.extBar, pendBear.ext, zBot, qual, pendBear.touches, pendBear.age, legStart,
             pendBear.oP, pendBear.oBar, pendBear.oAt, na(pendBear.runBar) ? pendBear.extBar : pendBear.runBar)
        if qual and gradeS != "invalid" and not indS
            lastLbDir := -1
            if biasMode == "Auto" and biasDir != -1
                biasDir := -1
                applyBias(biasDir)
        if gradeS == "clean"
            lastBearLbBorn := bar_index
        pendBear := Pending.new()
    else
        pendBear.miss += 1
        if pendBear.miss > confirmBars
            pendBear := Pending.new()

insideAliveZone(bool isBull, float p) =>
    bool inside = false
    if array.size(blocks) > 0
        for blk in blocks
            if not blk.dead and blk.isBull == isBull and p <= blk.top and p >= blk.bot
                inside := true
                break
    inside

// ------------------------------------ 5. register new liquidity levels -----
// v9: a swing = strictly beyond the pivotLen bars on its left, beyond-or-equal
// on its right — a run of equal extremes registers once, on its first bar
// (equal lows used to cancel each other out under ta.pivotlow)
pivotLowTie(int len) =>
    float v = low[len]
    bool ok = true
    for k = 1 to len
        if low[len + k] <= v or low[len - k] < v
            ok := false
    ok ? v : na

pivotHighTie(int len) =>
    float v = high[len]
    bool ok = true
    for k = 1 to len
        if high[len + k] >= v or high[len - k] > v
            ok := false
    ok ? v : na

// v9 LB vs build-up: a later pivot holding within eqTol of a live zone's
// extreme is a respect of it; at the build-up touch count the zone retires
// and its extreme becomes a level — a target, not a block
respectZone(bool isBull, float p, int pBar) =>
    if array.size(blocks) > 0
        for i = array.size(blocks) - 1 to 0
            Block blk = array.get(blocks, i)
            if not blk.dead and blk.isBull == isBull and pBar > blk.left
                float ext = isBull ? blk.bot : blk.top
                float gap = isBull ? p - ext : ext - p
                if gap >= 0 and gap <= eqTol * atrVal
                    blk.respects += 1
                    if 1 + blk.respects >= minTouches
                        blk.dead := true
                        if isBull
                            registerLevel(lowLvls, true, blk.left, ext, 1 + blk.respects)
                        else
                            registerLevel(highLvls, false, blk.left, ext, 1 + blk.respects)
                        killBlock(i, blk)
                    break
    true

float pl = pivotLowTie(pivotLen)
float ph = pivotHighTie(pivotLen)

if not na(pl)
    // the sweep extreme itself holds no liquidity (docs/MARCO.md §2.3) —
    // skip lows born inside an unresolved sweep's own excursion (beyond the
    // swept level); a low inside a live bullish zone is a respect of it (v9)
    if na(pendBull.lvl) or pl > pendBull.lvl
        if insideAliveZone(true, pl)
            respectZone(true, pl, bar_index - pivotLen)
        else
            registerLevel(lowLvls, true, bar_index - pivotLen, pl)

if not na(ph)
    if na(pendBear.lvl) or ph < pendBear.lvl
        if insideAliveZone(false, ph)
            respectZone(false, ph, bar_index - pivotLen)
        else
            registerLevel(highLvls, false, bar_index - pivotLen, ph)

// ------------------------------------------ 6. trap pointers (v11, V8) -----
// "grab this low, drag it over": the intact origin of the last inducing move
// per side, drawn from its bar to now; gone once run or once it becomes an
// alive same-side LB extreme (the box says it then)
// an origin older than the structure window (structBars) has left the structure the grade reads — the pointer expires with it
bool showUp = showPointers and not na(sw.upP) and na(sw.upTaken) and bar_index - sw.upBar <= structBars and not atAliveExtreme(true, sw.upP) and not insideAliveZone(true, sw.upP)
bool showDn = showPointers and not na(sw.dnP) and na(sw.dnTaken) and bar_index - sw.dnBar <= structBars and not atAliveExtreme(false, sw.dnP) and not insideAliveZone(false, sw.dnP)
if showUp
    string txtUp = "trap ↓ " + str.tostring(sw.upP, format.mintick) + " · buyers induced @" + str.tostring(sw.upLvl, format.mintick)
    if na(ptrBull)
        ptrBull  := line.new(sw.upBar, sw.upP, bar_index, sw.upP, color = color.new(colBull, 25), width = 1, style = line.style_dashed)
        ptrBullL := label.new(bar_index, sw.upP, txtUp, style = label.style_label_left, color = color.new(colBull, 70),
             textcolor = color.white, size = size.tiny)
    else
        line.set_xy1(ptrBull, sw.upBar, sw.upP)
        line.set_xy2(ptrBull, bar_index, sw.upP)
        label.set_xy(ptrBullL, bar_index, sw.upP)
        label.set_text(ptrBullL, txtUp)
else if not na(ptrBull)
    line.delete(ptrBull)
    label.delete(ptrBullL)
    ptrBull  := na
    ptrBullL := na
if showDn
    string txtDn = "trap ↑ " + str.tostring(sw.dnP, format.mintick) + " · sellers induced @" + str.tostring(sw.dnLvl, format.mintick)
    if na(ptrBear)
        ptrBear  := line.new(sw.dnBar, sw.dnP, bar_index, sw.dnP, color = color.new(colBear, 25), width = 1, style = line.style_dashed)
        ptrBearL := label.new(bar_index, sw.dnP, txtDn, style = label.style_label_left, color = color.new(colBear, 70),
             textcolor = color.white, size = size.tiny)
    else
        line.set_xy1(ptrBear, sw.dnBar, sw.dnP)
        line.set_xy2(ptrBear, bar_index, sw.dnP)
        label.set_xy(ptrBearL, bar_index, sw.dnP)
        label.set_text(ptrBearL, txtDn)
else if not na(ptrBear)
    line.delete(ptrBear)
    label.delete(ptrBearL)
    ptrBear  := na
    ptrBearL := na

// ---------------------------------------------------------------- alerts ---
alertcondition(originRunBull, "V8 — buyers' origin run (trap for longs)", "The low the buyers' move came from was run — the induced buyers are trapped; a reclaim there is the long")
alertcondition(originRunBear, "V8 — sellers' origin run (trap for shorts)", "The high the sellers' move came from was run — the induced sellers are trapped; a reclaim there is the short")
alertcondition(tapBullQ, "Tap — qualified bullish LB", "Price tapped a QUALIFIED bullish liquidity block")
alertcondition(tapBearQ, "Tap — qualified bearish LB", "Price tapped a QUALIFIED bearish liquidity block")
alertcondition(tapBull or tapBear, "Tap — any LB", "Price tapped a liquidity block")
