//@version=6
indicator("0x Fractals Advanced", overlay = true, max_lines_count = 500, max_labels_count = 500)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
left_bars      = input.int(2,   "Left Bars",   minval = 1)
right_bars     = input.int(2,   "Right Bars",  minval = 1)
lookback       = input.int(100, "Lookback Bars", minval = 10, maxval = 500,
     tooltip = "How many bars back to track fractals")

show_naked     = input.bool(true, "Show Naked Fractals (live liquidity)",    group = "Levels")
show_swept     = input.bool(true, "Show Swept Fractals (dead, faded triangle)", group = "Levels")
show_sweepers  = input.bool(true, "Show Sweeper Fractals (stop candidates)", group = "Levels")
show_sfp       = input.bool(true, "Show Wick Sweeps (SFP)", group = "Levels",
     tooltip = "Highlights bars whose wick takes the latest N same-direction naked fractals but whose close stays back inside the level.")
show_sfp_label = input.bool(true, "Show SFP Labels", group = "Levels",
     tooltip = "If off, draws only the SFP line without the SFP-H/SFP-L price label.")
sfp_scope      = input.int(2, "SFP Scope (latest N fractals)", minval = 1, maxval = 5, group = "Levels",
     tooltip = "Only sweeps of the latest N same-direction fractals (any state) get tagged as SFP. Matches the 'previous / previous-previous' read.")
sfp_max_dist   = input.int(10, "SFP Max Distance (bars)", minval = 1, maxval = 50, group = "Levels",
     tooltip = "SFP fires only when the wick-sweep bar is within this many bars after the fractal pivot. Keeps SFP focused on adjacent-swing sweeps — far-away sweeps stay tagged as SW.")
extend_right   = input.int(5, "Extend Naked Rays Right (bars)", minval = 0, maxval = 50, group = "Levels")
sweeper_tail   = input.int(5, "Sweeper Marker Length (bars)",   minval = 1, maxval = 50, group = "Levels")

naked_high_col = input.color(color.new(#ef5350, 0),  "Naked High Color",  group = "Colors")
naked_low_col  = input.color(color.new(#26a69a, 0),  "Naked Low Color",   group = "Colors")
sweeper_col    = input.color(color.new(#C77700, 0),  "Sweeper Color",     group = "Colors",
     tooltip = "Sweeper = pivot that took out prior naked liquidity. No resting liquidity on it, so it's a stop candidate, not an entry target.")
sfp_high_col   = input.color(color.new(#AB47BC, 0),  "SFP High Color (bearish)", group = "Colors")
sfp_low_col    = input.color(color.new(#5C6BC0, 0),  "SFP Low Color (bullish)",  group = "Colors")
swept_transp   = input.int(80, "Swept Triangle Transparency (0-100)", minval = 0, maxval = 100, group = "Colors",
     tooltip = "Higher = more faded. Swept fractals are dead liquidity; they show only as a faint triangle.")

line_width_in  = input.int(1, "Line Width", minval = 1, maxval = 4)
line_style_in  = input.string("dashed", "Naked Line Style", options = ["solid", "dashed", "dotted"])

// -----------------------------------------------------------------------------
// Fractal tracker
// -----------------------------------------------------------------------------
type Fractal
    int   bar
    float price
    bool  isHigh
    bool  swept
    int   sweptBar
    bool  isSweeper
    bool  sfpHit
    int   t

var array<Fractal> fractals = array.new<Fractal>()

ph = ta.pivothigh(left_bars, right_bars)
pl = ta.pivotlow(left_bars, right_bars)

// -----------------------------------------------------------------------------
// Sweep / sweeper detection
// -----------------------------------------------------------------------------
bool  newSweepThisBar  = false
bool  sweepBodyThisBar = false
bool  sweepWickThisBar = false
float newSweepLevel    = na
bool  newSweepIsHigh   = false

// Identify the latest N same-direction fractals (regardless of swept state)
// before any sweep logic runs this bar. SFP classification is gated to sweeps
// of these adjacent-swing levels only — counting includes swept fractals so
// stale naked liquidity doesn't sneak into the pool just because newer levels
// already got taken.
array<int> sfpHighIdx = array.new<int>()
array<int> sfpLowIdx  = array.new<int>()
// Pine v6 disallows negative step in `for ... by`, so walk newest-first via `while`.
int sfp_j = array.size(fractals) - 1
while sfp_j >= 0
    f = array.get(fractals, sfp_j)
    if f.isHigh and array.size(sfpHighIdx) < sfp_scope
        array.push(sfpHighIdx, sfp_j)
    else if (not f.isHigh) and array.size(sfpLowIdx) < sfp_scope
        array.push(sfpLowIdx, sfp_j)
    if array.size(sfpHighIdx) >= sfp_scope and array.size(sfpLowIdx) >= sfp_scope
        break
    sfp_j := sfp_j - 1

// On new confirmed pivot: if it took out any same-direction naked fractal during
// its formation, mark those fractals swept (if not already) and tag the new
// pivot as a sweeper. A sweeper has no resting liquidity on it.
if not na(ph)
    int ph_pivot_bar = bar_index - right_bars
    bool ph_is_sweeper = false
    if array.size(fractals) > 0
        for i = 0 to array.size(fractals) - 1
            f = array.get(fractals, i)
            if f.isHigh and f.bar < ph_pivot_bar and ph >= f.price
                if not f.swept
                    f.swept         := true
                    f.sweptBar      := ph_pivot_bar
                    ph_is_sweeper   := true
                    newSweepThisBar := true
                    newSweepLevel   := f.price
                    newSweepIsHigh  := true
                else if f.sweptBar >= ph_pivot_bar
                    ph_is_sweeper := true
    array.push(fractals, Fractal.new(ph_pivot_bar, ph, true, false, 0, ph_is_sweeper, false, time[right_bars]))

if not na(pl)
    int pl_pivot_bar = bar_index - right_bars
    bool pl_is_sweeper = false
    if array.size(fractals) > 0
        for i = 0 to array.size(fractals) - 1
            f = array.get(fractals, i)
            if (not f.isHigh) and f.bar < pl_pivot_bar and pl <= f.price
                if not f.swept
                    f.swept         := true
                    f.sweptBar      := pl_pivot_bar
                    pl_is_sweeper   := true
                    newSweepThisBar := true
                    newSweepLevel   := f.price
                    newSweepIsHigh  := false
                else if f.sweptBar >= pl_pivot_bar
                    pl_is_sweeper := true
    array.push(fractals, Fractal.new(pl_pivot_bar, pl, false, false, 0, pl_is_sweeper, false, time[right_bars]))

// Per-bar sweep detection: catches sweeps by bars whose pivot role is not (yet)
// confirmed. Keeps the `swept` state live for real-time reading.
//
// Classifies each sweep as body break (close beyond the level) vs wick-only
// sweep (close back inside = SFP). SFP tagging is restricted to fractals in
// sfpHighIdx / sfpLowIdx — the latest N same-direction naked levels.
if array.size(fractals) > 0
    for i = 0 to array.size(fractals) - 1
        f = array.get(fractals, i)
        if not f.swept and bar_index > f.bar
            bool isHi    = f.isHigh
            bool touched = isHi ? high >= f.price : low <= f.price
            if touched
                bool wickOnly    = isHi ? close < f.price : close > f.price
                bool inScope     = isHi ? array.includes(sfpHighIdx, i) : array.includes(sfpLowIdx, i)
                bool inRange     = (bar_index - f.bar) <= sfp_max_dist
                bool sfpEligible = inScope and inRange

                f.swept         := true
                f.sweptBar      := bar_index
                newSweepThisBar := true
                newSweepLevel   := f.price
                newSweepIsHigh  := isHi

                if wickOnly
                    if sfpEligible
                        f.sfpHit         := true
                        sweepWickThisBar := true
                else
                    sweepBodyThisBar := true

// Prune fractals older than the lookback window
while array.size(fractals) > 0 and (bar_index - array.get(fractals, 0).bar) > lookback
    array.shift(fractals)

// -----------------------------------------------------------------------------
// Render on the last bar only
// -----------------------------------------------------------------------------
var array<line>  drawn_lines  = array.new<line>()
var array<label> drawn_labels = array.new<label>()

line_style = line_style_in == "dashed" ? line.style_dashed :
             line_style_in == "dotted" ? line.style_dotted : line.style_solid

if barstate.islast
    if array.size(drawn_lines) > 0
        for i = 0 to array.size(drawn_lines) - 1
            line.delete(array.get(drawn_lines, i))
        array.clear(drawn_lines)
    if array.size(drawn_labels) > 0
        for i = 0 to array.size(drawn_labels) - 1
            label.delete(array.get(drawn_labels, i))
        array.clear(drawn_labels)

    right_x = bar_index + extend_right

    // Visible bar range — used to draw only fractals whose pivot bar is on
    // screen, so off-screen levels can't stretch the vertical auto-scale.
    int left_t  = chart.left_visible_bar_time
    int right_t = chart.right_visible_bar_time

    if array.size(fractals) > 0
        for i = 0 to array.size(fractals) - 1
            f = array.get(fractals, i)
            col_base   = f.isHigh ? naked_high_col : naked_low_col
            bool isSw  = (not f.swept) and f.isSweeper
            bool visible = isSw ? show_sweepers : (f.swept ? show_swept : show_naked)
            // Draw only if the pivot bar is within the visible range. Fall back
            // to drawing all if the viewport is momentarily unavailable (na).
            bool inView = na(left_t) or na(right_t) or (f.t >= left_t and f.t <= right_t)

            if visible and inView
                // Triangle marker at the pivot bar, drawn as a text character so
                // it renders smaller than label.style_triangleup/down. Color
                // reflects state:
                //  - live sweeper  → amber
                //  - swept         → faded col_base
                //  - naked         → bright col_base
                tri_txt  = f.isHigh ? "▼" : "▲"
                tri_yloc = f.isHigh ? yloc.abovebar : yloc.belowbar
                color tri_col = col_base
                if isSw
                    tri_col := sweeper_col
                else if f.swept
                    tri_col := color.new(col_base, swept_transp)
                tri = label.new(f.bar, f.price, tri_txt,
                     xloc = xloc.bar_index, yloc = tri_yloc,
                     style = label.style_none,
                     textcolor = tri_col,
                     size = size.tiny)
                array.push(drawn_labels, tri)

            if isSw and show_sweepers and inView
                // SWEEPER: stop candidate — amber line + SW label.
                tail_x = f.bar + sweeper_tail
                ln = line.new(f.bar, f.price, tail_x, f.price,
                     xloc = xloc.bar_index, color = sweeper_col,
                     style = line.style_solid, width = line_width_in)
                array.push(drawn_lines, ln)
                txt = f.isHigh ? "SW-H " : "SW-L "
                lb = label.new(tail_x, f.price,
                     txt + str.tostring(f.price),
                     xloc = xloc.bar_index, yloc = yloc.price,
                     style = label.style_label_left,
                     color = color.new(sweeper_col, 70),
                     textcolor = sweeper_col,
                     size = size.small)
                array.push(drawn_labels, lb)

            else if (not f.swept) and show_naked and inView
                // NAKED: live liquidity — bright ray + NFH/NFL.
                txt = f.isHigh ? "NFH" : "NFL"
                ln  = line.new(f.bar, f.price, right_x, f.price,
                     xloc = xloc.bar_index, color = col_base,
                     style = line_style, width = line_width_in)
                array.push(drawn_lines, ln)
                lb  = label.new(right_x, f.price,
                     txt + " " + str.tostring(f.price),
                     xloc = xloc.bar_index, yloc = yloc.price,
                     style = label.style_label_left,
                     color = color.new(col_base, 80),
                     textcolor = col_base,
                     size = size.small)
                array.push(drawn_labels, lb)
            // Swept (not sweeper) → triangle only, no extra marker.

            // SFP marker: line from the swept fractal's pivot bar to the bar
            // that wick-swept it. Distinct color from sweeper (amber) so the
            // two stop-candidate flavors are visually separable.
            if f.sfpHit and show_sfp and inView
                color sfp_col = f.isHigh ? sfp_high_col : sfp_low_col
                ln_sfp = line.new(f.bar, f.price, f.sweptBar, f.price,
                     xloc = xloc.bar_index, color = sfp_col,
                     style = line.style_solid, width = line_width_in)
                array.push(drawn_lines, ln_sfp)
                if show_sfp_label
                    txt_sfp = f.isHigh ? "SFP-H " : "SFP-L "
                    lb_sfp = label.new(f.sweptBar, f.price,
                         txt_sfp + str.tostring(f.price),
                         xloc = xloc.bar_index, yloc = yloc.price,
                         style = label.style_label_left,
                         color = color.new(sfp_col, 70),
                         textcolor = sfp_col,
                         size = size.small)
                    array.push(drawn_labels, lb_sfp)

// -----------------------------------------------------------------------------
// Alerts
// Gated on barstate.isconfirmed so triggers only fire on bar close — wick vs
// body classification is a closing read and meaningless intrabar.
// -----------------------------------------------------------------------------
bool sweepBodyConfirmed = sweepBodyThisBar and barstate.isconfirmed
bool sweepWickConfirmed = sweepWickThisBar and barstate.isconfirmed

if sweepBodyConfirmed
    alert("0xFA Sweep BODY: " + (newSweepIsHigh ? "HIGH" : "LOW") + " @ " +
         str.tostring(newSweepLevel) + " on " + syminfo.ticker + " " + timeframe.period,
         alert.freq_once_per_bar_close)

if sweepWickConfirmed
    alert("0xFA Sweep WICK (SFP): " + (newSweepIsHigh ? "HIGH" : "LOW") + " @ " +
         str.tostring(newSweepLevel) + " on " + syminfo.ticker + " " + timeframe.period,
         alert.freq_once_per_bar_close)

alertcondition(sweepBodyConfirmed,
     title   = "Liquidity Sweep (body)",
     message = "0x Fractals: body sweep on {{ticker}} {{interval}}")
alertcondition(sweepWickConfirmed,
     title   = "Liquidity Sweep (wick/SFP)",
     message = "0x Fractals: wick sweep / SFP on {{ticker}} {{interval}}")